---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" description="This page does not exist. Try SAT Math practice, Reading and Writing practice or the guide to the digital SAT." noindex>
  <div class="mx-auto max-w-6xl px-4 py-16">
    <p class="num text-brand text-sm font-semibold">404</p>
    <h1 class="mt-2 text-3xl md:text-4xl font-extrabold">That page isn't here.</h1>
    <p class="mt-3 text-muted-foreground max-w-[55ch]">The link may be old or mistyped. Try one of these:</p>
    <ul class="mt-6 grid gap-2 max-w-xl">
      <li><a href="/sat/math/">SAT Math practice</a></li>
      <li><a href="/sat/reading-writing/">SAT Reading and Writing practice</a></li>
      <li><a href="/sat/">How the digital SAT works</a></li>
      <li><a href="/guides/">Guides</a></li>
    </ul>
  </div>
</Base>
