---
import HubLayout from "../../../layouts/HubLayout.astro";
import { pageDates } from "../../../page-dates.js";
import { mathSkills, MATH_DOMAINS, mathSet } from "../../../lib/quiz/bank.js";
import { collectionSchema } from "../../../lib/schema.js";
import { CHECKED } from "../../../lib/data/sources.js";
const d = pageDates("/sat/math/");
const skills = mathSkills();
const DOMAIN_INFO: Record<string, { share: string; questions: string; blurb: string }> = {
  "Algebra": {
    share: "~35% of Math",
    questions: "13–15 questions",
    blurb: "Linear equations, systems of linear equations, linear inequalities, and linear functions in one and two variables."
  },
  "Advanced Math": {
    share: "~35% of Math",
    questions: "13–15 questions",
    blurb: "Quadratic equations, nonlinear functions, exponents, radicals, and equivalent algebraic expressions."
  },
  "Problem-Solving and Data Analysis": {
    share: "~15% of Math",
    questions: "5–7 questions",
    blurb: "Ratios, rates, proportional relationships, percentages, one-variable data distributions, and probability models."
  },
  "Geometry and Trigonometry": {
    share: "~15% of Math",
    questions: "5–7 questions",
    blurb: "Right triangles, trigonometry, circle equations, area, perimeter, and 3D volume calculations."
  }
};
---
<HubLayout
  topic="math"
  title="SAT Math Practice Questions With Explanations"
  h1="SAT Math practice"
  description="Free SAT Math practice by skill: algebra, advanced math, data analysis and geometry. Unlimited generated questions, each checked by code, with step-by-step explanations."
  lead={`Pick a skill and practice as long as you like. Every question is generated with fresh numbers, its answer is checked by code, and each one comes with a step-by-step explanation. ${skills.length} skills across all four SAT Math domains.`}
  published={d.published}
  updated={d.updated}
  checked={CHECKED}
  extraSchema={[collectionSchema({ name: "SAT Math practice", description: "SAT Math practice by skill", path: "/sat/math/", items: skills.map((s) => ({ name: s.name, path: s.href })) })]}
>
  <div class="not-prose my-6 grid gap-6 sm:grid-cols-2">
    {MATH_DOMAINS.map((dom) => {
      const list = skills.filter((s) => s.domain === dom);
      const info = DOMAIN_INFO[dom];
      return (
        <div class="rounded-xl border border-border bg-card p-6 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 border-b border-border pb-3">
              <h2 class="font-display text-lg font-bold text-foreground">{dom}</h2>
              <span class="rounded bg-brand/10 px-2 py-0.5 text-xs font-semibold text-brand whitespace-nowrap">
                {info?.share}
              </span>
            </div>
            <p class="text-muted-foreground mt-2 text-xs leading-relaxed">
              {info?.blurb} ({info?.questions} on test)
            </p>
            <ul class="mt-4 divide-y divide-border/60 text-sm">
              {list.map((s) => (
                <li class="py-2.5 flex items-center justify-between gap-2">
                  <a href={s.href} class="font-medium text-foreground hover:text-brand hover:underline no-underline">
                    {s.name}
                  </a>
                  <span class="text-muted-foreground text-xs">&rarr;</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      );
    })}
  </div>

  <h2>Practice tools for SAT Math</h2>
  <div class="not-prose my-4 grid gap-4 sm:grid-cols-3">
    <div class="rounded-xl border border-border bg-card p-5">
      <span class="text-xs font-semibold text-brand uppercase">Cheat Sheet</span>
      <h3 class="font-display mt-1 text-base font-bold text-foreground">Digital SAT Math Formulas</h3>
      <p class="text-muted-foreground text-xs mt-1">
        Official 12 reference formulas plus 25 must-memorize algebra, quadratic, geometry, and circle formulas.
      </p>
      <a href="/sat/math-formulas/" class="mt-3 inline-block text-xs font-semibold text-brand hover:underline no-underline">
        View Formula Sheet &rarr;
      </a>
    </div>
    <div class="rounded-xl border border-border bg-card p-5">
      <span class="text-xs font-semibold text-brand uppercase">Pacing Tool</span>
      <h3 class="font-display mt-1 text-base font-bold text-foreground">Digital SAT Section Timer</h3>
      <p class="text-muted-foreground text-xs mt-1">
        Official 35-minute Math countdown with ~95s per question pacing tracker and 5-minute alerts.
      </p>
      <a href="/sat/timer/" class="mt-3 inline-block text-xs font-semibold text-brand hover:underline no-underline">
        Launch Math Timer &rarr;
      </a>
    </div>
    <div class="rounded-xl border border-border bg-card p-5">
      <span class="text-xs font-semibold text-brand uppercase">Score Tool</span>
      <h3 class="font-display mt-1 text-base font-bold text-foreground">Score & Superscore Calculator</h3>
      <p class="text-muted-foreground text-xs mt-1">
        Calculate your scaled Math score (200–800) and estimate performance across multi-stage adaptive modules.
      </p>
      <a href="/sat/score-calculator/" class="mt-3 inline-block text-xs font-semibold text-brand hover:underline no-underline">
        Calculate SAT Score &rarr;
      </a>
    </div>
  </div>

  <h2>How our math questions are made</h2>
  <p>Each skill has a question template written by hand. Every time you ask for a set, the template fills in new numbers, chosen so the answer comes out exact. The wrong choices come from specific mistakes, like a sign error or dividing by the wrong value, so missing a question tells you which mistake you made. Before any question reaches you, code solves it a second, independent way and rejects it if the two answers disagree. <a href="/how-we-write-questions/">More on how we write questions</a>.</p>
</HubLayout>
