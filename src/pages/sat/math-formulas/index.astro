        <a href="/sat/timer/" class="rounded-lg bg-brand px-5 py-2.5 text-xs font-semibold text-brand-foreground whitespace-nowrap text-center no-underline hover:opacity-90">
          Open Digital SAT Timer &rarr;
        </a>
