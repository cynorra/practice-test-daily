    </footer>
  </main>
</Base>

<script is:inline>
  const buttons = document.querySelectorAll(".cat-btn");
  const sections = document.querySelectorAll(".formula-section");

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const cat = btn.getAttribute("data-cat");

      buttons.forEach((b) => {
        b.className = "cat-btn px-3.5 py-1.5 text-xs font-semibold rounded-lg text-muted-foreground hover:bg-muted";
      });
      btn.className = "cat-btn px-3.5 py-1.5 text-xs font-semibold rounded-lg bg-brand text-brand-foreground shadow-sm";

      sections.forEach((sec) => {
        if (cat === "all" || sec.getAttribute("data-section") === cat) {
          sec.classList.remove("hidden");
        } else {
          sec.classList.add("hidden");
        }
      });
    });
  });
</script>

