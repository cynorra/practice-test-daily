---
import HubLayout from "../../layouts/HubLayout.astro";
import Faq from "../../components/Faq.astro";
import { pageDates } from "../../page-dates.js";
import { src, CHECKED } from "../../lib/data/sources.js";
import { faqSchema, collectionSchema } from "../../lib/schema.js";
import { mathSkills, rwSkills, MATH_DOMAINS, RW_DOMAINS } from "../../lib/quiz/bank.js";

const d = pageDates("/sat/");
const math = mathSkills();
const rw = rwSkills();

const faq = [
  { q: "How long is the SAT?", a: "About 2 hours and 14 minutes of testing: 64 minutes for Reading and Writing and 70 minutes for Math, with a short break between the sections." },
  { q: "How many questions are on the SAT?", a: "98 in total: 54 in Reading and Writing (two modules of 27) and 44 in Math (two modules of 22). A few in each module are unscored pretest questions that aren't marked." },
  { q: "What does adaptive mean on the digital SAT?", a: "Each section has two modules. How you do on the first module decides whether the second module is easier or harder." },
];

const allSkills = [...math, ...rw];
---
<HubLayout
  topic="strategy"
  title="SAT Practice by Skill: Free Digital SAT Questions & Explanations"
  h1="SAT Practice by Skill"
  description="Free digital SAT practice by skill for Math and Reading & Writing. Practice algebra, geometry, grammar, and reading with explanations for every answer choice."
  lead="Practice the digital SAT one skill at a time. Browse all 14 Math skills and 6 Reading and Writing skills, each with worked explanations for every choice, verified math formulas, and instant feedback."
  published={d.published}
  updated={d.updated}
  checked={CHECKED}
  facts={[
    { label: "Math skills", value: "14 skills across 4 domains" },
    { label: "Reading & Writing", value: "6 skills across 4 domains" },
    { label: "Testing time", value: "2 h 14 min (98 questions)" },
    { label: "Explanations", value: "For every right & wrong choice" },
  ]}
  sources={[src("uworldFormat"), src("cbDomains"), src("cbSat")]}
  extraSchema={[
    collectionSchema({
      name: "SAT Practice by Skill",
      description: "Digital SAT practice by skill for Math and Reading & Writing",
      path: "/sat/",
      items: allSkills.map((s) => ({ name: s.name, path: s.href })),
    }),
    faqSchema(faq),
  ]}
>
  <h2>Browse SAT Math practice by domain</h2>
  <p>Every SAT Math skill features unlimited generated questions checked by an independent code solver, with step-by-step explanations for each choice.</p>

  <div class="not-prose my-6 grid gap-5 sm:grid-cols-2">
    {MATH_DOMAINS.map((dom) => {
      const domSkills = math.filter((s) => s.domain === dom);
      return (
        <div class="bg-card rounded-xl border p-5 shadow-sm">
          <div class="flex items-center justify-between border-b pb-3">
            <h3 class="font-display text-base font-bold text-foreground">{dom}</h3>
            <span class="bg-muted text-muted-foreground rounded-full px-2.5 py-0.5 text-xs font-medium">{domSkills.length} skills</span>
          </div>
          <ul class="mt-4 space-y-2.5">
            {domSkills.map((s) => (
              <li>
                <a href={s.href} class="text-foreground hover:text-brand group flex items-center justify-between text-sm font-medium no-underline transition-colors">
                  <span>{s.name}</span>
                  <span class="text-muted-foreground group-hover:text-brand text-xs font-semibold">Start &rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      );
    })}
  </div>
  <p><a href="/sat/math/">Explore all Math skills and question generation details &rarr;</a></p>

  <h2>Browse SAT Reading and Writing practice by domain</h2>
  <p>All verbal questions are passage-based and written by hand, with explanations analyzing why the correct choice works and why each distractor is wrong.</p>

  <div class="not-prose my-6 grid gap-5 sm:grid-cols-2">
    {RW_DOMAINS.map((dom) => {
      const domSkills = rw.filter((s) => s.domain === dom);
      return (
        <div class="bg-card rounded-xl border p-5 shadow-sm">
          <div class="flex items-center justify-between border-b pb-3">
            <h3 class="font-display text-base font-bold text-foreground">{dom}</h3>
            <span class="bg-muted text-muted-foreground rounded-full px-2.5 py-0.5 text-xs font-medium">{domSkills.length} skill{domSkills.length > 1 ? "s" : ""}</span>
          </div>
          <ul class="mt-4 space-y-2.5">
            {domSkills.map((s) => (
              <li>
                <a href={s.href} class="text-foreground hover:text-brand group flex items-center justify-between text-sm font-medium no-underline transition-colors">
                  <span>{s.name}</span>
                  <span class="text-muted-foreground group-hover:text-brand text-xs font-semibold">{s.count} questions &rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      );
    })}
  </div>
  <p><a href="/sat/reading-writing/">Explore all Reading and Writing skills &rarr;</a></p>

  <h2>Free SAT practice tools</h2>
  <div class="not-prose my-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div class="rounded-xl border border-border bg-card p-5 flex flex-col justify-between">
      <div>
        <span class="text-xs font-semibold text-brand uppercase">Practice Tool</span>
        <h3 class="font-display mt-1 text-base font-bold text-foreground">Digital SAT Section Timer</h3>
        <p class="text-muted-foreground mt-1.5 text-xs leading-relaxed">
          Official module countdowns (32m Reading & Writing, 35m Math, 10m break) with live question pacing indicator and 5-minute warnings.
        </p>
      </div>
      <div class="mt-4">
        <a href="/sat/timer/" class="text-xs font-semibold text-brand hover:underline no-underline">
          Open Digital SAT Timer &rarr;
        </a>
      </div>
    </div>

    <div class="rounded-xl border border-border bg-card p-5 flex flex-col justify-between">
      <div>
        <span class="text-xs font-semibold text-brand uppercase">Score Tool</span>
        <h3 class="font-display mt-1 text-base font-bold text-foreground">Score & Superscore Calculator</h3>
        <p class="text-muted-foreground mt-1.5 text-xs leading-relaxed">
          Estimate your 400–1600 scaled score from raw test answers and calculate your official superscore across test dates.
        </p>
      </div>
      <div class="mt-4">
        <a href="/sat/score-calculator/" class="text-xs font-semibold text-brand hover:underline no-underline">
          Open Score Calculator &rarr;
        </a>
      </div>
    </div>

    <div class="rounded-xl border border-border bg-card p-5 flex flex-col justify-between">
      <div>
        <span class="text-xs font-semibold text-brand uppercase">Formula Sheet</span>
        <h3 class="font-display mt-1 text-base font-bold text-foreground">SAT Math Formulas Sheet</h3>
        <p class="text-muted-foreground mt-1.5 text-xs leading-relaxed">
          The 12 official reference formulas plus 25 must-memorize algebra, quadratic, and geometry formulas with practice links.
        </p>
      </div>
      <div class="mt-4">
        <a href="/sat/math-formulas/" class="text-xs font-semibold text-brand hover:underline no-underline">
          View Formula Sheet &rarr;
        </a>
      </div>
    </div>

    <div class="rounded-xl border border-border bg-card p-5 flex flex-col justify-between">
      <div>
        <span class="text-xs font-semibold text-brand uppercase">Score Strategy</span>
        <h3 class="font-display mt-1 text-base font-bold text-foreground">SAT to ACT Score Converter</h3>
        <p class="text-muted-foreground mt-1.5 text-xs leading-relaxed">
          Official joint concordance calculator to convert SAT totals to ACT composite scores and view corresponding score bands.
        </p>
      </div>
      <div class="mt-4">
        <a href="/sat/sat-to-act-converter/" class="text-xs font-semibold text-brand hover:underline no-underline">
          Open Score Converter &rarr;
        </a>
      </div>
    </div>
  </div>

  <h2>Digital SAT format at a glance</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Section</th><th>Modules</th><th>Questions per module</th><th>Time per module</th><th>Total</th></tr></thead>
      <tbody>
        <tr><td>Reading and Writing</td><td>2</td><td>27</td><td>32 minutes</td><td>54 questions, 64 minutes</td></tr>
        <tr><td>Math</td><td>2</td><td>22</td><td>35 minutes</td><td>44 questions, 70 minutes</td></tr>
      </tbody>
    </table>
    <caption>Each module includes two unscored pretest questions that aren't marked, so answer every question.</caption>
  </div>

  <h2>How the adaptive modules work</h2>
  <p>Both sections start with a first module of mixed difficulty. Your result on it decides which second module you get: a harder one if you did well, an easier one otherwise. Higher scores are only reachable through the harder second module, which is why accuracy on the first module matters so much.</p>

  <h2>A note on official materials</h2>
  <p>This site is independent. Our questions are written for practice in the SAT's format; they are not official College Board questions. For full-length practice tests in the real testing app, use the College Board's own free materials alongside ours.</p>

  <Faq items={faq} />
</HubLayout>
