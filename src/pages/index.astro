---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { SITE, AUTHOR } from "../site.config.js";
import { TOPIC_BY_KEY } from "../lib/topics.js";
import { GUIDE_IMAGES } from "../lib/guide-images.js";
import { mathSkills, rwSkills, MATH_DOMAINS, RW_DOMAINS } from "../lib/quiz/bank.js";

const math = mathSkills(), rw = rwSkills();
const all = (await getCollection("guides", (g) => !g.data.draft)).sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const guides = all.slice(0, 6);
const fmtDate = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
---
<Base title={`Free SAT Practice and English Tests With Explanations | ${SITE.name}`} description={SITE.description}>
  <section class="relative overflow-hidden border-b">
    <div class="plan-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-4 pt-12 pb-12 md:pt-16">
      <p class="text-brand text-sm font-semibold tracking-wider uppercase">Free digital SAT prep</p>
      <h1 class="mt-3 max-w-[20ch] text-4xl leading-[1.05] font-extrabold md:text-6xl">Learn the SAT one skill at a time.</h1>
      <p class="text-muted-foreground mt-5 max-w-[62ch] text-lg">
        {SITE.name} is a free study site for the digital SAT, with free English tests as well. We publish step-by-step guides that explain how the test works and how to solve each question type, and we pair them with free practice questions for every Math and Reading and Writing skill, each with an explanation for every answer choice.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/guides/" class="bg-brand text-brand-foreground rounded-lg px-5 py-2.5 font-semibold no-underline">Read the guides</a>
        <a href="/sat/" class="bg-card rounded-lg border px-5 py-2.5 font-semibold text-foreground no-underline">Browse practice by skill</a>
      </div>
    </div>
  </section>

  <section class="border-b" aria-labelledby="what-h">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <h2 id="what-h" class="text-2xl font-extrabold md:text-3xl">What you will find here</h2>
      <ul class="mt-6 grid gap-4 md:grid-cols-3">
        <li class="bg-card rounded-xl border p-5">
          <h3 class="font-display text-lg font-bold">Study guides</h3>
          <p class="text-muted-foreground mt-2 text-sm">Long-form articles on the test format, pacing, study plans, and the math and grammar rules the SAT tests most. Each one has worked examples and an original illustration.</p>
          <a href="/guides/" class="mt-3 inline-block text-sm font-medium">Read the guides →</a>
        </li>
        <li class="bg-card rounded-xl border p-5">
          <h3 class="font-display text-lg font-bold">Practice by skill</h3>
          <p class="text-muted-foreground mt-2 text-sm">{math.length} Math skills and {rw.length} Reading and Writing skills, each with its own practice page. Pick the skill you are weakest at instead of working through a random mix.</p>
          <a href="/sat/" class="mt-3 inline-block text-sm font-medium">See all skills →</a>
        </li>
        <li class="bg-card rounded-xl border p-5">
          <h3 class="font-display text-lg font-bold">Explanations for every choice</h3>
          <p class="text-muted-foreground mt-2 text-sm">Each answer explains why the right choice is right and which mistake leads to each wrong one, so you learn the pattern, not just the answer.</p>
          <a href="/how-we-write-questions/" class="mt-3 inline-block text-sm font-medium">How we write questions →</a>
        </li>
      </ul>
    </div>
  </section>

  {guides.length > 0 && (
    <section aria-labelledby="guides-h" class="border-b">
      <div class="mx-auto max-w-6xl px-4 py-12">
        <div class="flex items-baseline justify-between gap-4">
          <h2 id="guides-h" class="text-2xl font-extrabold md:text-3xl">Latest SAT guides</h2>
          <a href="/guides/" class="text-sm font-medium">All guides →</a>
        </div>
        <ul class="mt-6 grid gap-5 md:grid-cols-3">
          {guides.map((g) => {
            const art = GUIDE_IMAGES[g.id];
            return (
              <li class="bg-card overflow-hidden rounded-xl border">
                {art && (
                  <a href={`/guides/${g.id}/`} tabindex="-1" aria-hidden="true">
                    <img src={`/images/guides/${g.id}.png`} alt="" width="1200" height="630" loading="lazy" decoding="async" class="aspect-[1200/630] w-full border-b object-cover" />
                  </a>
                )}
                <div class="p-5">
                  <p class="text-muted-foreground text-xs font-semibold tracking-wider uppercase">{TOPIC_BY_KEY[g.data.tool]?.label}</p>
                  <a href={`/guides/${g.id}/`} class="font-display mt-2 block text-lg leading-snug font-bold">{g.data.title}</a>
                  <p class="text-muted-foreground mt-2 text-sm">{g.data.description}</p>
                  <p class="text-muted-foreground mt-3 text-xs">{fmtDate(g.data.published)}</p>
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}

  <section class="border-b" aria-labelledby="english-h">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <p class="text-brand text-xs font-semibold tracking-wider uppercase">Language Skills & Diagnostics</p>
          <h2 id="english-h" class="mt-1 text-2xl font-extrabold md:text-3xl">Free English tests and diagnostics</h2>
          <p class="text-muted-foreground mt-2 max-w-[62ch]">
            Evaluate your English proficiency, expand your academic vocabulary, and master essential grammar rules with interactive quizzes and choice-by-choice explanations.
          </p>
        </div>
        <a href="/english/" class="text-brand hover:underline inline-flex items-center gap-1 text-sm font-semibold whitespace-nowrap no-underline">
          View all English tests &rarr;
        </a>
      </div>

      <div class="mt-8 grid gap-5 lg:grid-cols-3">
        <!-- Featured Level Test -->
        <div class="lg:col-span-1 rounded-2xl border-2 border-brand/30 bg-card p-6 shadow-sm flex flex-col justify-between">
          <div>
            <span class="inline-block rounded-md bg-brand/10 px-2.5 py-1 text-xs font-semibold text-brand">Featured Diagnostic</span>
            <h3 class="font-display mt-3 text-xl font-bold text-foreground">English Level Test (CEFR A1–C2)</h3>
            <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
              25 carefully calibrated questions that diagnose your reading and grammar level from beginner (A1) to proficient (C2). Get your instant band score and study recommendation.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-border flex items-center justify-between">
            <span class="text-xs text-muted-foreground font-medium">25 questions • ~15 mins</span>
            <a href="/english/english-level-test/" class="bg-brand text-brand-foreground hover:opacity-90 inline-flex items-center rounded-lg px-4 py-2 text-xs font-semibold no-underline">
              Start Test &rarr;
            </a>
          </div>
        </div>

        <!-- 4 Grid Cards -->
        <div class="lg:col-span-2 grid gap-4 sm:grid-cols-2">
          <div class="rounded-xl border border-border bg-card p-5 flex flex-col justify-between">
            <div>
              <span class="text-xs font-semibold text-muted-foreground uppercase">Vocabulary</span>
              <h3 class="font-display mt-1 text-base font-bold text-foreground">Vocabulary Practice Test</h3>
              <p class="text-muted-foreground mt-1.5 text-xs leading-relaxed">
                40 academic and high-frequency words tested in realistic sentence contexts with distractor breakdowns.
              </p>
            </div>
            <div class="mt-4 flex items-center justify-between text-xs">
              <span class="text-muted-foreground">40 questions</span>
              <a href="/english/vocabulary-test/" class="font-semibold text-brand hover:underline no-underline">Take quiz &rarr;</a>
            </div>
          </div>

          <div class="rounded-xl border border-border bg-card p-5 flex flex-col justify-between">
            <div>
              <span class="text-xs font-semibold text-muted-foreground uppercase">Grammar</span>
              <h3 class="font-display mt-1 text-base font-bold text-foreground">English Grammar Test</h3>
              <p class="text-muted-foreground mt-1.5 text-xs leading-relaxed">
                30 questions evaluating clause boundaries, connectors, subject-verb agreement, and modifier placement.
              </p>
            </div>
            <div class="mt-4 flex items-center justify-between text-xs">
              <span class="text-muted-foreground">30 questions</span>
              <a href="/english/grammar-test/" class="font-semibold text-brand hover:underline no-underline">Take quiz &rarr;</a>
            </div>
          </div>

          <div class="rounded-xl border border-border bg-card p-5 flex flex-col justify-between">
            <div>
              <span class="text-xs font-semibold text-muted-foreground uppercase">Targeted Grammar</span>
              <h3 class="font-display mt-1 text-base font-bold text-foreground">Pronouns Diagnostic</h3>
              <p class="text-muted-foreground mt-1.5 text-xs leading-relaxed">
                20 questions focused on relative pronouns (who/whom/which), reflexive usage, and pronoun-antecedent agreement.
              </p>
            </div>
            <div class="mt-4 flex items-center justify-between text-xs">
              <span class="text-muted-foreground">20 questions</span>
              <a href="/english/grammar-test/pronouns/" class="font-semibold text-brand hover:underline no-underline">Take quiz &rarr;</a>
            </div>
          </div>

          <div class="rounded-xl border border-border bg-card p-5 flex flex-col justify-between">
            <div>
              <span class="text-xs font-semibold text-muted-foreground uppercase">Targeted Grammar</span>
              <h3 class="font-display mt-1 text-base font-bold text-foreground">Verb Tenses Mastery</h3>
              <p class="text-muted-foreground mt-1.5 text-xs leading-relaxed">
                20 questions targeting irregular past participles, modal verbs, conditionals, and perfect aspect shifts.
              </p>
            </div>
            <div class="mt-4 flex items-center justify-between text-xs">
              <span class="text-muted-foreground">20 questions</span>
              <a href="/english/grammar-test/verbs/" class="font-semibold text-brand hover:underline no-underline">Take quiz &rarr;</a>
            </div>
          </div>
        </div>
      </div>

      <!-- TOEFL iBT Callout -->
      <div class="mt-6 rounded-xl border border-border bg-card/60 p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <span class="text-xs font-semibold text-brand uppercase">Standardized Exam Practice</span>
          <h3 class="font-display text-base font-bold text-foreground">Preparing for the TOEFL iBT?</h3>
          <p class="text-muted-foreground text-xs mt-0.5">
            Practice academic reading passages and email or discussion writing tasks built around official ETS exam formats.
          </p>
        </div>
        <a href="/toefl/" class="bg-card hover:bg-accent border border-border text-foreground px-4 py-2 rounded-lg text-xs font-semibold whitespace-nowrap text-center no-underline">
          Go to TOEFL Practice &rarr;
        </a>
      </div>
    </div>
  </section>

  <section class="border-b" aria-labelledby="how-h">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <h2 id="how-h" class="text-2xl font-extrabold md:text-3xl">How to use the site</h2>
      <ol class="mt-6 grid gap-4 md:grid-cols-3">
        {[
          ["1", "Learn how the test works", "Start with the format guide: four timed modules, about two hours of testing, and how the score is built."],
          ["2", "Find your weak skills", "Take a full practice test elsewhere or use the study plan, then list the skills you missed most."],
          ["3", "Practice one skill at a time", "Read the guide for that skill, then work its practice page and read every explanation."],
        ].map(([n, h, p]) => (
          <li class="bg-card rounded-xl border p-5">
            <span class="bg-brand text-brand-foreground grid size-8 place-items-center rounded-full text-sm font-bold">{n}</span>
            <h3 class="mt-3 text-base font-bold">{h}</h3>
            <p class="text-muted-foreground mt-1 text-sm">{p}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section aria-labelledby="skills-h">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 md:grid-cols-2">
      <div>
        <h2 id="skills-h" class="text-2xl font-extrabold">Math skills</h2>
        {MATH_DOMAINS.map((dom) => (
          <div class="mt-5">
            <h3 class="text-muted-foreground text-xs font-semibold tracking-wider uppercase">{dom}</h3>
            <ul class="mt-2 grid gap-1">{math.filter((s) => s.domain === dom).map((s) => <li><a href={s.href}>{s.name}</a></li>)}</ul>
          </div>
        ))}
      </div>
      <div>
        <h2 class="text-2xl font-extrabold">Reading and Writing skills</h2>
        {RW_DOMAINS.map((dom) => {
          const list = rw.filter((s) => s.domain === dom);
          return list.length > 0 && (
            <div class="mt-5">
              <h3 class="text-muted-foreground text-xs font-semibold tracking-wider uppercase">{dom}</h3>
              <ul class="mt-2 grid gap-1">{list.map((s) => <li><a href={s.href}>{s.name}</a></li>)}</ul>
            </div>
          );
        })}
        <p class="text-muted-foreground mt-6 text-sm">New to the digital SAT? Start with <a href="/sat/">how the test works</a>.</p>
      </div>
    </div>
  </section>

  <section class="border-t">
    <div class="mx-auto grid max-w-6xl gap-4 px-4 py-14 sm:grid-cols-3">
      {[
        ["Every answer checked", "Math questions are solved twice, by the template and by an independent check in code. A question whose answers disagree never reaches you."],
        ["Every choice explained", "Explanations cover why the right answer is right and what mistake leads to each wrong one."],
        ["Original questions", "Written for this site in the SAT's format. Not copied from official tests or other prep sites."],
      ].map(([h, p]) => (
        <div class="bg-card rounded-xl border p-5">
          <h3 class="text-base font-bold">{h}</h3>
          <p class="text-muted-foreground mt-1 text-sm">{p}</p>
        </div>
      ))}
    </div>
    <p class="mx-auto max-w-6xl px-4 pb-4 text-sm text-muted-foreground">Built and written by <a href={`/author/${AUTHOR.slug}/`}>{AUTHOR.name}</a>. Read our <a href="/about/">about page</a> and <a href="/editorial-policy/">editorial policy</a>.</p>
    <p class="mx-auto max-w-6xl px-4 pb-14 text-sm text-muted-foreground">{SITE.name} is independent and not affiliated with College Board. TOEFL and TOEFL iBT are registered trademarks of ETS. This site is not affiliated with or endorsed by ETS. SAT® is a trademark registered by the College Board, which is not affiliated with, and does not endorse, this site.</p>
  </section>
</Base>
