---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { getCollection } from "astro:content";
import { breadcrumbSchema, collectionSchema } from "../../lib/schema.js";
import { TOPICS } from "../../lib/topics.js";
import { GUIDE_IMAGES } from "../../lib/guide-images.js";

const all = (await getCollection("guides", (g) => !g.data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const groups = TOPICS
  .map((t) => ({ key: t.key, label: t.topic, href: t.href, name: t.hubName, items: all.filter((g) => g.data.tool === t.key) }))
  .filter((g) => g.items.length > 0);
const crumbs = [{ name: "Home", path: "/" }, { name: "Guides", path: "/guides/" }];
---
<Base
  title="SAT Guides"
  description="SAT strategy guides: how the digital test works, pacing, math shortcuts and the grammar rules the Reading and Writing section tests most."
  schema={[breadcrumbSchema(crumbs), collectionSchema({ name: "Guides", description: "SAT strategy guides.", path: "/guides/", items: all.map((g) => ({ name: g.data.title, path: `/guides/${g.id}/` })) })]}
>
  <div class="mx-auto max-w-6xl px-4 pt-6">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="mt-4 text-3xl md:text-4xl font-extrabold">Guides</h1>
    <p class="mt-3 text-lg text-muted-foreground max-w-[60ch]">Strategy for every part of the digital SAT, with each fact about the test checked against published sources.</p>
    <div class="tick-rule mt-6 max-w-md"></div>

    {groups.map((group) => (
      <section class="mt-10" aria-labelledby={`g-${group.key}`}>
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h2 id={`g-${group.key}`} class="text-xl font-extrabold">{group.label}</h2>
          {group.name && <a href={group.href} class="text-sm font-medium">{group.name} →</a>}
        </div>
        <ul class="mt-4 grid gap-5 md:grid-cols-2">
          {group.items.map((g) => (
            <li class="bg-card overflow-hidden rounded-xl border">
              {GUIDE_IMAGES[g.id] && (
                <a href={`/guides/${g.id}/`} tabindex="-1" aria-hidden="true">
                  <img src={`/images/guides/${g.id}.png`} alt="" width="1200" height="630" loading="lazy" decoding="async" class="aspect-[1200/630] w-full border-b object-cover" />
                </a>
              )}
              <div class="p-5">
              <a href={`/guides/${g.id}/`} class="font-display text-lg font-bold leading-snug">{g.data.title}</a>
              <p class="text-sm text-muted-foreground mt-1">{g.data.description}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
