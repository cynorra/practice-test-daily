---
import Logo from "./Logo.astro";
import { SITE, FOOTER_LINKS } from "../site.config.js";
import { mathSkills, rwSkills } from "../lib/quiz/bank.js";
const year = new Date().getFullYear();
---
<footer class="mt-20 border-t border-border bg-card">
  <div class="mx-auto max-w-6xl px-4 py-10 grid gap-8 sm:grid-cols-2 md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)_minmax(0,1fr)_minmax(0,1fr)]">
    <div class="flex flex-col gap-2">
      <a href="/" class="flex items-center gap-2 no-underline text-foreground">
        <Logo size={22} />
        <span class="font-display font-extrabold">{SITE.name}</span>
      </a>
      <p class="text-sm text-muted-foreground max-w-xs">
        Free SAT practice by skill, English diagnostic tests, and interactive prep tools with explanations for every answer choice.
      </p>
    </div>
    <nav aria-label="Practice">
      <h2 class="text-xs uppercase tracking-wider text-muted-foreground mb-3">SAT Skills</h2>
      <ul class="grid gap-1.5 text-sm">
        <li><a href="/sat/math/">SAT Math ({mathSkills().length} skills)</a></li>
        <li><a href="/sat/reading-writing/">Reading & Writing ({rwSkills().length} skills)</a></li>
        <li><a href="/sat/">All SAT Skills Hub</a></li>
        <li><a href="/guides/">All Study Guides</a> · <a href="/rss.xml">RSS</a></li>
      </ul>
    </nav>
    <nav aria-label="Practice Tools">
      <h2 class="text-xs uppercase tracking-wider text-muted-foreground mb-3">Tools & Tests</h2>
      <ul class="grid gap-1.5 text-sm">
        <li><a href="/sat/timer/">Digital SAT Section Timer</a></li>
        <li><a href="/sat/score-calculator/">Score & Superscore Calculator</a></li>
        <li><a href="/sat/sat-to-act-converter/">SAT to ACT Converter</a></li>
        <li><a href="/english/english-level-test/">Free English Level Test</a></li>
        <li><a href="/toefl/">TOEFL Reading & Writing</a></li>
      </ul>
    </nav>
    <nav aria-label="Site information">
      <h2 class="text-xs uppercase tracking-wider text-muted-foreground mb-3">About this site</h2>
      <ul class="grid gap-1.5 text-sm">
        {FOOTER_LINKS.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="border-t border-border">
    <div class="mx-auto max-w-6xl px-4 py-4 text-xs text-muted-foreground space-y-1">
      <p>© {year} {SITE.name}. An independent educational site.</p>
      <p>SAT is a registered trademark of the College Board. This site is not affiliated with or endorsed by the College Board.</p>
      <p>TOEFL and TOEFL iBT are registered trademarks of ETS. This site is not affiliated with or endorsed by ETS.</p>
    </div>
  </div>
</footer>
